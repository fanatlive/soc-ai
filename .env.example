# ===== LLM (необязательно: без ключа работает честный резервный режим rules_only) =====
# Что сделать: 1) вставьте ключ после LLM_API_KEY=  2) перезапустите сервер.
# Проверка: http://127.0.0.1:8000/api/health  ->  provider.state = "ready" после первого анализа.
#
# По умолчанию настроен Gemini (ключ: https://aistudio.google.com/apikey).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash
# Запасные модели через запятую (до двух). Используются только если основная перегружена (HTTP 5xx).
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite
#
# Вместо Gemini можно использовать OpenAI-совместимый API, например:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=<идентификатор модели вашего аккаунта>
#   LLM_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=4
LLM_QUEUE_TIMEOUT_SECONDS=2

# ===== Приложение =====
DATABASE_URL=sqlite:///./soc_triage.db
AUTO_SEED_DEMO=true
TRUSTED_NETWORKS=192.168.0.0/16
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Для внешнего размещения задайте случайный токен (не менее 24 символов).
# Токен защищает чтение и изменение событий. Без него API доступен только с loopback.
API_TOKEN=
